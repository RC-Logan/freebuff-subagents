[TEMPLATE]
# MINIMAL SETUP: cp this file to .env, set NVIDIA_API_KEY, then run
# ./bin/check-env.sh to verify before installing.
#
# ---------------------------------------------------------------------------
# Providers — plug in your own API for each model type
# ---------------------------------------------------------------------------
# Two provider types:
#   text   = high-reasoning, non-vision model (coding, research, review)
#   vision = multimodal model (browser, screenshots, design)
#
# Resolution: vision falls back to text; text falls back to the NVIDIA
# defaults below. So the minimal setup is just NVIDIA_API_KEY, and if you want
# ONE model for both provider types (or your text model dominates), set only
# TEXT_MODEL and leave VISION_* empty.

# NVIDIA hosted NIM defaults (key at https://build.nvidia.com)
NVIDIA_API_KEY=
DEFAULT_MODEL=z-ai/glm-5.2
BASE_URL=https://integrate.api.nvidia.com/v1

# Text provider overrides (optional)
# TEXT_MODEL=your-text-model-id
# TEXT_API_KEY=
# TEXT_BASE_URL=https://your-endpoint/v1

# Vision provider overrides (optional; falls back to the text provider)
# VISION_MODEL=minimaxai/minimax-m3
# VISION_API_KEY=
# VISION_BASE_URL=

# ---------------------------------------------------------------------------
# OpenHands / install
# ---------------------------------------------------------------------------
# Pin an OpenHands version for reproducibility (empty = latest).
OPENHANDS_VERSION=

# The Freebuff skill was removed (2026-08-16) in favor of an MCP server
# (planned — see DECISIONS.md #13/#16). Fallback: the skill is preserved in
# git history at tag skill-fallback. No skills-dir setting exists anymore.

# ---- Sandbox (CRITICAL for safety) -------------------------------------------
# docker (default): agent commands run inside a Docker container. Only the
# delegated working directory (plus any SANDBOX_VOLUMES) is shared with the
# host; host filesystem, SSH keys, and credentials are NOT reachable unless
# explicitly mounted. Keep this.
# process: commands run directly on your machine with your user permissions —
# NO container isolation. delegate.sh REFUSES this unless ALLOW_PROCESS_SANDBOX=1.
RUNTIME=docker

# Optional read-write mounts into the sandbox (format host_path:container_path[:mode]).
# Anything mounted read-write can be modified by the agent — mount only what the
# task needs, never credential directories (e.g. ~/.ssh, ~/.aws).
SANDBOX_VOLUMES=

# Only set to 1 if you understand the risk and have no Docker.
# ALLOW_PROCESS_SANDBOX=1

# Safety bounds for the agent loop (see docs/WHY.md, section 2).
MAX_ITERATIONS=25
